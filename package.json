{
  "name": "@local/dsh-project-board",
  "version": "1.0.3",
  "private": true,
  "description": "DeepSeek Harness plugin: project/session task board, floating session HUD, keyboard-first navigation, and task notifications.",
  "license": "CC-BY-NC-SA-4.0",
  "author": "CGArtLab",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "project-board",
    "session-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cgartlab/dsh-project-board.git"
  },
  "homepage": "https://github.com/cgartlab/dsh-project-board",
  "bugs": "https://github.com/cgartlab/dsh-project-board/issues",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-bundle.cjs && node scripts/check-i18n.cjs",
    "check:bundle": "node scripts/check-bundle.cjs",
    "check:i18n": "node scripts/check-i18n.cjs",
    "test": "node --test test/load.test.cjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}


